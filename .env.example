# Copy to .env and adjust. Never commit .env.
DCRAG_ENV=local
DCRAG_LOG_LEVEL=INFO

# Generation (local by default; the Azure adapter arrives in a later iteration)
DCRAG_GENERATOR=ollama
DCRAG_OLLAMA_BASE_URL=http://localhost:11434
DCRAG_OLLAMA_MODEL=qwen2.5:7b-instruct

# Retrieval
DCRAG_EMBEDDING_MODEL=BAAI/bge-m3
DCRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DCRAG_VECTOR_STORE=faiss
DCRAG_QDRANT_URL=http://localhost:6333
DCRAG_TOP_K=5

# API (required once the API iteration lands)
DCRAG_API_KEY=change-me
